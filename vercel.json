{
  "buildCommand": "cd ruet-find-client && npm install && npm run build",
  "outputDirectory": "ruet-find-client/dist",
  "installCommand": "cd ruet-find-client && npm install",
  "framework": "vite",
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
